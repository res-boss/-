# Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Gmail 주소와 "앱 비밀번호" (일반 비밀번호 아님)
# 발급: Google 계정 → 보안 → 2단계 인증 켜기 → 앱 비밀번호
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# 리포트를 받을 주소 (비우면 EMAIL_ADDRESS로 발송)
REPORT_TO=

# 분석 품질을 높이는 배경 정보 (업종, 회사 규모, 진행 중인 분쟁 등)
USER_CONTEXT=한국 엔터테인먼트 회사 대표 (예: 아티스트 매니지먼트·음반·공연, 일본·미국 파트너와 거래)

# 선택 설정
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
IMAP_FOLDER=INBOX
SINCE_DAYS=1
MAX_EMAILS=20
